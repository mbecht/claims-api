# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

DB_URL=jdbc:postgresql://localhost:5432/claims
DB_USERNAME=claims_user
DB_PASSWORD=changeme

# HMAC-SHA256 signing key for JWTs, base64-encoded, >= 32 bytes. Generate your own with:
#   openssl rand -base64 32
JWT_SECRET=changeme-generate-your-own-32-byte-base64-secret
